CONFIG_IDF_TARGET="esp32s3"
CONFIG_AUDIO_BOARD_TEST_RUN_I2C_SCAN=y
CONFIG_AUDIO_BOARD_TEST_RUN_1KHZ_TONE=y
CONFIG_AUDIO_BOARD_TEST_RUN_MIC_RMS=y
# CONFIG_AUDIO_BOARD_TEST_RUN_LOCAL_LOOPBACK is not set
# CONFIG_AUDIO_BOARD_TEST_RUN_WS_ECHO is not set
CONFIG_XIAOZHI_AUDIO_DIAG_TONE_MS=500
CONFIG_XIAOZHI_AUDIO_DIAG_MIC_RMS_DURATION_MS=5000
CONFIG_XIAOZHI_AUDIO_DIAG_MIC_RMS_WINDOW_MS=500
CONFIG_XIAOZHI_AUDIO_DIAG_LOOPBACK_MS=5000
CONFIG_XIAOZHI_AUDIO_DIAG_VOLUME=40
CONFIG_XIAOZHI_AUDIO_DIAG_TONE_AMPLITUDE=12000
